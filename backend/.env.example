# Copy to .env for local development:  cp .env.example .env
# .env is gitignored — never commit real credentials.

# --- App ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
APP_NAME=devops-app
APP_VERSION=2.0.0

# --- Database (option A: discrete vars, matches Kubernetes ConfigMap + Secret) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=appdb
DB_USER=appuser
DB_PASSWORD=change-me
DB_SSL=false
DB_POOL_MAX=10

# --- Database (option B: single connection string, overrides the above) ---
# DATABASE_URL=postgres://appuser:change-me@localhost:5432/appdb
