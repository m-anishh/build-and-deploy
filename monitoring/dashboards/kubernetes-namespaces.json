{
  "title": "manishOps — Kubernetes / Namespaces",
  "uid": "manishops-k8s-namespaces",
  "tags": ["manishOps", "kubernetes"],
  "schemaVersion": 39,
  "editable": true,
  "time": { "from": "now-15m", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "namespace",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(kube_pod_info, namespace)",
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1, "title": "CPU utilization (cores)", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 30, "stacking": { "mode": "normal" } }, "unit": "short" } },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=~\"$namespace\", container!=\"\"}[5m])) by (namespace)",
        "legendFormat": "{{namespace}}"
      }]
    },
    {
      "id": 2, "title": "Memory usage", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 30, "stacking": { "mode": "normal" } }, "unit": "bytes" } },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "sum(container_memory_working_set_bytes{namespace=~\"$namespace\", container!=\"\"}) by (namespace)",
        "legendFormat": "{{namespace}}"
      }]
    },
    {
      "id": 3, "title": "CPU utilization (from limits)", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "percent" } },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "100 * sum(rate(container_cpu_usage_seconds_total{namespace=~\"$namespace\", container!=\"\"}[5m])) by (namespace) / sum(kube_pod_container_resource_limits{namespace=~\"$namespace\", resource=\"cpu\"}) by (namespace)",
        "legendFormat": "{{namespace}}"
      }]
    },
    {
      "id": 4, "title": "Memory utilization (from requests)", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "percent" } },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "100 * sum(container_memory_working_set_bytes{namespace=~\"$namespace\", container!=\"\"}) by (namespace) / sum(kube_pod_container_resource_requests{namespace=~\"$namespace\", resource=\"memory\"}) by (namespace)",
        "legendFormat": "{{namespace}}"
      }]
    },
    {
      "id": 5, "title": "CPU utilization (from requests)", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "percent" } },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "100 * sum(rate(container_cpu_usage_seconds_total{namespace=~\"$namespace\", container!=\"\"}[5m])) by (namespace) / sum(kube_pod_container_resource_requests{namespace=~\"$namespace\", resource=\"cpu\"}) by (namespace)",
        "legendFormat": "{{namespace}}"
      }]
    },
    {
      "id": 6, "title": "Memory utilization (from limits)", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "percent" } },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "100 * sum(container_memory_working_set_bytes{namespace=~\"$namespace\", container!=\"\"}) by (namespace) / sum(kube_pod_container_resource_limits{namespace=~\"$namespace\", resource=\"memory\"}) by (namespace)",
        "legendFormat": "{{namespace}}"
      }]
    },
    {
      "id": 7, "title": "Storage: PVC usage (%)", "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "percent" } },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "100 * kubelet_volume_stats_used_bytes{namespace=~\"$namespace\"} / kubelet_volume_stats_capacity_bytes{namespace=~\"$namespace\"}",
        "legendFormat": "{{namespace}}/{{persistentvolumeclaim}}"
      }]
    },
    {
      "id": 8, "title": "Pod restarts (by namespace)", "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=~\"$namespace\"}[15m])) by (namespace)",
        "legendFormat": "{{namespace}}"
      }]
    },
    {
      "id": 9, "title": "Running pods (by namespace)", "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "sum(kube_pod_status_phase{namespace=~\"$namespace\", phase=\"Running\"}) by (namespace)",
        "legendFormat": "{{namespace}}"
      }]
    }
  ]
}
